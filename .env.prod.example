APP_PORT=3000
POSTGRES_DB=ontology_agent
POSTGRES_USER=ontology_agent
POSTGRES_PASSWORD=replace-with-a-production-database-password
SESSION_SECRET=replace-with-a-long-production-session-secret
REDIS_KEY_PREFIX=dip3
ERP_API_BASE_URL=https://erp.example.com/api
ENABLE_URL_BRIDGE=0
CUBE_API_SECRET=replace-with-a-production-cube-secret
CUBE_QUERY_TIMEOUT_MS=15000
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-production-neo4j-password
NEO4J_DATABASE=neo4j
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=replace-with-a-production-provider-key
LLM_PROVIDER_MODEL=replace-with-provider-model
LLM_PROVIDER_MODE=openai-compatible
LLM_PROVIDER_TOOL_CALLING=true
LLM_PROVIDER_STRUCTURED_OUTPUT=native-json-schema
JAVA_GRAPH_SYNC_ENABLED=true
JAVA_GRAPH_SYNC_POLL_DELAY=5m
JAVA_GRAPH_SYNC_SOURCES=erp.organizations,erp.projects,erp.owners,erp.charge_items,erp.receivables,erp.payments,erp.service_orders
GRAPH_SYNC_OPS_SECRET=replace-with-a-long-production-graph-sync-ops-secret
