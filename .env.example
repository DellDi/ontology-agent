APP_PORT=3000
# Database（数据库所有权已移交 Java backend，migrate 由 Flyway 独立执行）
POSTGRES_DB=ontology_agent
# Local port for Postgres (not container port)
POSTGRES_PORT=55432
POSTGRES_USER=ontology_agent
POSTGRES_PASSWORD=ontology_agent_dev_password
# Redis（仅供 Java backend 唤醒与 Chat Memory 使用，Web 不再持有）
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-a-local-dev-session-secret
ENABLE_DEV_ERP_AUTH=0
REDIS_KEY_PREFIX=dip3
# 会话 Cookie 是否带 Secure（生产容器显式置 true）
COOKIE_SECURE=false
# ERP 目录认证（账号密码登录）
ERP_API_BASE_URL=http://your-erp-host/api
ENABLE_URL_BRIDGE=0
# CUBE
CUBE_PORT=4000
CUBE_API_URL=http://127.0.0.1:4000/cubejs-api/v1
CUBE_API_SECRET=replace-with-a-local-dev-cube-secret
CUBE_QUERY_TIMEOUT_MS=15000
# NEO4J
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-real-neo4j-password
NEO4J_DATABASE=neo4j
# LLM_PROVIDER
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=replace-with-a-real-provider-key
LLM_PROVIDER_MODEL=replace-with-provider-model
LLM_PROVIDER_MODE=openai-compatible
LLM_PROVIDER_TOOL_CALLING=true
LLM_PROVIDER_STRUCTURED_OUTPUT=native-json-schema
# Optional EasyV source database. Keep disabled unless a test/development source is configured.
EASYV_POSTGRES_ENABLED=false
EASYV_POSTGRES_JDBC_URL=
EASYV_POSTGRES_USERNAME=
EASYV_POSTGRES_PASSWORD=
EASYV_POSTGRES_SCHEMA=easyv_saas
EASYV_POSTGRES_REQUIRE_READ_ONLY_ROLE=true
# Required only by LiveEasyVProviderIT.
LIVE_EASYV_USER_ID=
LIVE_EASYV_FROM=
LIVE_EASYV_TO=
# Explicit opt-in: persist the live test Session/Job/Snapshot in JAVA_DATABASE_* instead of
# using the disposable Testcontainers platform ledger.
LIVE_EASYV_PERSIST_PLATFORM_RESULTS=false
JAVA_BACKEND_URL=http://127.0.0.1:8080
JAVA_BACKEND_PORT=8080
JAVA_WORKER_ENABLED=true
JAVA_GRAPH_SYNC_ENABLED=false
JAVA_GRAPH_SYNC_POLL_DELAY=5m
JAVA_GRAPH_SYNC_SOURCES=erp.organizations,erp.projects,erp.owners,erp.charge_items,erp.receivables,erp.payments,erp.service_orders
GRAPH_SYNC_OPS_SECRET=replace-with-a-local-graph-sync-ops-secret
RUN_LLM_PROVIDER_SMOKE_TEST=0

# Story 7.4 Observability
# 留空则 /api/metrics 对内部匿名访问开放（开发态默认）；
# 生产环境务必配置为长随机字符串，拉取 /api/metrics 时需提供
# `x-observability-token: <value>` 或 `Authorization: Bearer <value>`。
OBSERVABILITY_TOKEN=
# 自定义服务名，web 与 worker 日志聚合时用来区分。默认分别为 ontology-agent-web / ontology-agent-worker。
OBSERVABILITY_SERVICE_NAME=
# 可选：在启动日志里记录的版本号（CI 推镜像时注入 git sha 更佳）。
GIT_COMMIT_SHA=
