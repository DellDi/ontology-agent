{
  "name": "ontology-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "pnpm test:java && pnpm test:web",
    "test:java": "mise exec java@temurin-21.0.12+8.0.LTS -- mvn -f backend-java/pom.xml test",
    "test:web": "cross-env NODE_OPTIONS=--conditions=react-server node --import tsx --test tests/java-backend-contract.test.mjs tests/java-mobile-view-model.test.mjs tests/java-governance-contract.test.mjs tests/story-2-6-worker-skeleton.test.mjs tests/story-4-7-compose-services.test.mjs tests/story-7-3-container-deployment.test.mjs",
    "test:container": "cross-env RUN_CONTAINER_TESTS=1 node --test tests/story-7-3-container-deployment.test.mjs",
    "test:live:analysis": "mise exec java@temurin-21.0.12+8.0.LTS -- mvn -f backend-java/pom.xml verify -Plive-integration",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "lint": "eslint",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.1",
    "lucide-react": "^1.21.0",
    "mysql2": "^3.20.0",
    "neo4j-driver": "^6.0.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^5.11.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/env": "16.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "lightningcss": "1.32.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
