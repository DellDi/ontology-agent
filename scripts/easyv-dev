#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ENV_FILE=${EASYV_DEV_ENV_FILE:-"$ROOT_DIR/.env.easyv-dev"}
COMPOSE_FILE="$ROOT_DIR/compose.easyv-dev.yaml"

require_env_file() {
  if [[ ! -r "$ENV_FILE" ]]; then
    echo "Missing deployment environment file: $ENV_FILE" >&2
    exit 1
  fi
}

# Cube 只认识拆开的连接参数；平台库地址以 backend 实际使用的 JAVA_DATABASE_URL 为唯一来源，
# 统一解析为 CUBE_DB_HOST/CUBE_DB_PORT/CUBE_DB_NAME 供 compose 与备份/恢复复用。
derive_cube_db_env() {
  require_env_file
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  : "${JAVA_DATABASE_URL:?missing JAVA_DATABASE_URL}"
  if [[ ! "$JAVA_DATABASE_URL" =~ ^jdbc:postgresql://([A-Za-z0-9._-]+)(:([0-9]+))?/([^/?]+) ]]; then
    echo "JAVA_DATABASE_URL must be jdbc:postgresql://host[:port]/database: $JAVA_DATABASE_URL" >&2
    exit 1
  fi
  CUBE_DB_HOST=${BASH_REMATCH[1]}
  CUBE_DB_PORT=${BASH_REMATCH[3]:-5432}
  CUBE_DB_NAME=${BASH_REMATCH[4]}
  export CUBE_DB_HOST CUBE_DB_PORT CUBE_DB_NAME
}

compose() {
  derive_cube_db_env
  if docker compose version >/dev/null 2>&1; then
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  else
    docker-compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  fi
}

prepare_maven() {
  if command -v mvn >/dev/null 2>&1; then
    return
  fi
  local private_maven="$ROOT_DIR/.runtime/maven/bin/mvn"
  local private_java
  private_java=$(find "$ROOT_DIR/.runtime/jdk-root/usr/lib/jvm" -maxdepth 1 -type d \
    -name 'java-21-openjdk-*' -print -quit 2>/dev/null || true)
  if [[ ! -x "$private_maven" || ! -x "$private_java/bin/java" ]]; then
    echo "Java 21 and Maven are required; set PATH/JAVA_HOME or install the easyv-dev private runtime." >&2
    exit 1
  fi
  export JAVA_HOME="$private_java"
  export PATH="$ROOT_DIR/.runtime/maven/bin:$JAVA_HOME/bin:$PATH"
}

build_images() {
  prepare_maven
  local revision
  revision=${RELEASE_REVISION:-$(git -C "$ROOT_DIR" describe --always --dirty)}
  mvn -f "$ROOT_DIR/backend-java/pom.xml" -DskipTests package
  docker build -f "$ROOT_DIR/Dockerfile.java.runtime" \
    --build-arg "BUILD_REVISION=$revision" \
    -t "ontology-agent-java:$revision" -t ontology-agent-java:easyv-dev \
    "$ROOT_DIR/backend-java/target"
  docker build -f "$ROOT_DIR/Dockerfile.web.runtime" \
    --build-arg "BUILD_REVISION=$revision" \
    -t "ontology-agent-web:$revision" -t ontology-agent-web:easyv-dev "$ROOT_DIR"
}

wait_for_health() {
  local attempt backend web cube
  for attempt in $(seq 1 24); do
    backend=$(docker inspect ontology-agent-easyv-dev-backend-1 \
      --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
      2>/dev/null || true)
    web=$(docker inspect ontology-agent-easyv-dev-web-1 \
      --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
      2>/dev/null || true)
    cube=$(docker inspect ontology-agent-easyv-dev-cube-1 \
      --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
      2>/dev/null || true)
    if [[ "$backend" == "healthy" && "$web" == "healthy" && "$cube" == "healthy" ]]; then
      curl --fail --silent http://127.0.0.1:8080/actuator/health/easyv
      echo
      return
    fi
    sleep 5
  done
  compose ps --all
  echo "easyv-dev services did not become healthy" >&2
  exit 1
}

run_ingestion() {
  local mode=${1:-INCREMENTAL}
  mode=${mode^^}
  if [[ "$mode" != "FULL" && "$mode" != "INCREMENTAL" && "$mode" != "RECONCILE" ]]; then
    echo "ingest mode must be FULL, INCREMENTAL or RECONCILE" >&2
    exit 1
  fi
  local key
  for key in EASYV_POSTGRES_JDBC_URL EASYV_POSTGRES_USERNAME EASYV_POSTGRES_PASSWORD; do
    if [[ -z ${!key:-} ]]; then
      echo "Missing source environment variable: $key" >&2
      exit 1
    fi
  done
  EASYV_POSTGRES_SCHEMA=${EASYV_POSTGRES_SCHEMA:-easyv_saas} \
  EASYV_POSTGRES_REQUIRE_READ_ONLY_ROLE=${EASYV_POSTGRES_REQUIRE_READ_ONLY_ROLE:-true} \
  INGEST_MODE="$mode" compose --profile ops run --rm ingest
}

pg_credentials() {
  derive_cube_db_env
  : "${JAVA_DATABASE_USERNAME:?missing JAVA_DATABASE_USERNAME}"
  : "${JAVA_DATABASE_PASSWORD:?missing JAVA_DATABASE_PASSWORD}"
}

run_backup() {
  pg_credentials
  local out_dir=${1:-"$ROOT_DIR/backups"}
  mkdir -p "$out_dir"
  local stamp file
  stamp=$(date +%Y%m%d%H%M%S)
  file="$out_dir/ontology-agent-${CUBE_DB_NAME}-${stamp}.dump"
  # 平台库全量：platform/facts/ingestion/identity + public(flyway history)。
  # EasyV 源库为只读外部依赖，不在备份范围。
  PGPASSWORD="$JAVA_DATABASE_PASSWORD" docker run --rm \
    -e PGPASSWORD \
    -v "$out_dir:/backups" \
    postgres:15.4-bookworm \
    pg_dump -Fc -h "$CUBE_DB_HOST" -p "$CUBE_DB_PORT" \
      -U "$JAVA_DATABASE_USERNAME" -d "$CUBE_DB_NAME" \
      -n platform -n facts -n ingestion -n identity -n public \
      -f "/backups/$(basename "$file")"
  ls -lh "$file"
  echo "backup written: $file"
}

run_restore() {
  pg_credentials
  local file=${1:-}
  if [[ -z "$file" || ! -r "$file" ]]; then
    echo "usage: scripts/easyv-dev restore <backup.dump>" >&2
    exit 2
  fi
  echo "RESTORE into ${CUBE_DB_HOST}:${CUBE_DB_PORT}/${CUBE_DB_NAME}"
  echo "this overwrites platform/facts/ingestion/identity/public objects in the dump."
  read -r -p "type the database name to confirm: " confirm
  if [[ "$confirm" != "$CUBE_DB_NAME" ]]; then
    echo "aborted." >&2
    exit 1
  fi
  compose stop backend web migrate ingest release-worker 2>/dev/null || true
  PGPASSWORD="$JAVA_DATABASE_PASSWORD" docker run --rm \
    -e PGPASSWORD \
    -v "$(cd "$(dirname "$file")" && pwd):/backups" \
    postgres:15.4-bookworm \
    pg_restore --clean --if-exists --no-owner --no-privileges \
      -h "$CUBE_DB_HOST" -p "$CUBE_DB_PORT" \
      -U "$JAVA_DATABASE_USERNAME" -d "$CUBE_DB_NAME" \
      "/backups/$(basename "$file")"
  compose up -d
  wait_for_health
  echo "restore completed: $file"
}

run_property_ingestion() {
  local mode=${1:-INCREMENTAL}
  mode=${mode^^}
  if [[ "$mode" != "FULL" && "$mode" != "INCREMENTAL" && "$mode" != "RECONCILE" ]]; then
    echo "property-ingest mode must be FULL, INCREMENTAL or RECONCILE" >&2
    exit 1
  fi
  PROPERTY_INGEST_MODE="$mode" compose --profile ops run --rm property-ingest
}

run_graph_bootstrap() {
  local dataset_version_set_id=${1:-}
  if [[ -n "$dataset_version_set_id" ]]; then
    compose exec -T backend sh -c \
      'curl --fail --silent --show-error --get --request POST \
        --header "X-Graph-Sync-Ops-Secret: $GRAPH_SYNC_OPS_SECRET" \
        --data-urlencode "datasetVersionSetId=$1" \
        http://127.0.0.1:8080/api/system/graph-sync/bootstrap' \
      -- "$dataset_version_set_id"
  else
    compose exec -T backend sh -c \
      'curl --fail --silent --show-error --request POST \
        --header "X-Graph-Sync-Ops-Secret: $GRAPH_SYNC_OPS_SECRET" \
        http://127.0.0.1:8080/api/system/graph-sync/bootstrap'
  fi
  echo
}

print_facts_reader_sql() {
  derive_cube_db_env
  : "${CUBE_DATABASE_USERNAME:?missing CUBE_DATABASE_USERNAME}"
  local sql_file="$ROOT_DIR/scripts/sql/create-facts-reader-role.sql"
  echo "# facts 只读角色须由 DBA/CREATEROLE 账号创建一次（应用账号无建角色权限）："
  echo "psql '<DBA 连接串>' -v role='$CUBE_DATABASE_USERNAME' -v password='<新密码>' \\"
  echo "  -v database='$CUBE_DB_NAME' -f '$sql_file'"
  echo "# SQL 内容："
  cat "$sql_file"
}

seed_facts_reader() {
  derive_cube_db_env
  : "${FACTS_READER_DBA_USERNAME:?missing FACTS_READER_DBA_USERNAME}"
  : "${FACTS_READER_DBA_PASSWORD:?missing FACTS_READER_DBA_PASSWORD}"
  : "${CUBE_DATABASE_USERNAME:?missing CUBE_DATABASE_USERNAME}"
  : "${CUBE_DATABASE_PASSWORD:?missing CUBE_DATABASE_PASSWORD}"
  PGPASSWORD="$FACTS_READER_DBA_PASSWORD" psql -X --no-password --set=ON_ERROR_STOP=1 \
    -h "$CUBE_DB_HOST" -p "$CUBE_DB_PORT" -U "$FACTS_READER_DBA_USERNAME" -d "$CUBE_DB_NAME" \
    -v role="$CUBE_DATABASE_USERNAME" -v database="$CUBE_DB_NAME" \
    -f "$ROOT_DIR/scripts/sql/create-facts-reader-role.sql"
}

run_infrastructure_smoke() {
  wait_for_health
  compose exec -T backend sh -c \
    'curl --fail --silent --show-error http://127.0.0.1:8080/actuator/health/easyv'
  echo
  compose exec -T cube node -e \
    "fetch('http://127.0.0.1:4000/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
  echo "easyv and cube smoke passed"
}

run_cross_domain_smoke() {
  run_infrastructure_smoke
  compose exec -T backend sh -c \
    'curl --fail --silent --show-error http://127.0.0.1:8080/actuator/health/neo4j'
  echo
  compose exec -T backend sh -c \
    'curl --fail --silent --show-error --request GET \
      --header "X-Graph-Sync-Ops-Secret: $GRAPH_SYNC_OPS_SECRET" \
      http://127.0.0.1:8080/api/system/graph-sync/bootstrap/status'
  echo
  echo "cross-domain smoke passed"
}

command=${1:-}
case "$command" in
  build)
    build_images
    ;;
  config)
    require_env_file
    compose config --quiet
    ;;
  migrate)
    require_env_file
    # 首次安装由发布进程注入 DBA 凭据；日常升级仅以应用账号校验并授予 facts 读取权限。
    if [[ -n ${FACTS_READER_DBA_USERNAME:-} ]]; then seed_facts_reader; fi
    compose run --rm migrate
    ;;
  deploy)
    require_env_file
    compose config --quiet
    compose up -d
    wait_for_health
    ;;
  health)
    require_env_file
    wait_for_health
    ;;
  ingest)
    require_env_file
    run_ingestion "${2:-INCREMENTAL}"
    ;;
  admin-seed)
    require_env_file
    : "${ADMIN_SEED_USERNAME:?ADMIN_SEED_USERNAME is required}"
    : "${ADMIN_SEED_PASSWORD:?ADMIN_SEED_PASSWORD is required}"
    compose --profile ops run --rm admin-seed
    ;;
  release-worker)
    require_env_file
    for key in EASYV_POSTGRES_JDBC_URL EASYV_POSTGRES_USERNAME EASYV_POSTGRES_PASSWORD; do
      if [[ -z ${!key:-} ]]; then echo "Missing source environment variable: $key" >&2; exit 1; fi
    done
    EASYV_POSTGRES_SCHEMA=${EASYV_POSTGRES_SCHEMA:-easyv_saas} \
    EASYV_POSTGRES_REQUIRE_READ_ONLY_ROLE=${EASYV_POSTGRES_REQUIRE_READ_ONLY_ROLE:-true} \
      compose --profile ops up -d --no-deps release-worker
    ;;
  property-ingest)
    require_env_file
    run_property_ingestion "${2:-INCREMENTAL}"
    ;;
  backup)
    run_backup "${2:-}"
    ;;
  restore)
    run_restore "${2:-}"
    ;;
  graph-bootstrap)
    require_env_file
    run_graph_bootstrap "${2:-}"
    ;;
  facts-reader-sql)
    print_facts_reader_sql
    ;;
  facts-reader-seed)
    seed_facts_reader
    ;;
  infrastructure-smoke)
    require_env_file
    run_infrastructure_smoke
    ;;
  smoke|cross-domain-smoke)
    require_env_file
    run_cross_domain_smoke
    ;;
  status)
    require_env_file
    compose ps --all
    ;;
  logs)
    require_env_file
    compose logs --no-color --tail="${2:-100}" migrate backend web cube cubestore-router cubestore-worker neo4j
    ;;
  release)
    require_env_file
    build_images
    compose config --quiet
    compose up -d
    wait_for_health
    ;;
  *)
    echo "Usage: scripts/easyv-dev {build|config|migrate|deploy|health|ingest [FULL|INCREMENTAL|RECONCILE]|admin-seed|release-worker|property-ingest [FULL|INCREMENTAL|RECONCILE]|backup [dir]|restore <dump>|graph-bootstrap [datasetVersionSetId]|facts-reader-seed|facts-reader-sql|infrastructure-smoke|smoke|cross-domain-smoke|status|logs [lines]|release}" >&2
    exit 2
    ;;
esac
