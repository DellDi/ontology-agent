# Images are built once on easyv-dev; Compose never builds them implicitly.
ONTOLOGY_JAVA_IMAGE=ontology-agent-java:easyv-dev
ONTOLOGY_WEB_IMAGE=ontology-agent-web:easyv-dev
VALKEY_IMAGE=ghcr.io/valkey-io/valkey:8.1-alpine

# Shared platform PostgreSQL. This is not the EasyV source database.
JAVA_DATABASE_URL=jdbc:postgresql://platform-postgres.example.internal:5432/ontology_agent
JAVA_DATABASE_USERNAME=ontology_agent
JAVA_DATABASE_PASSWORD=replace-with-platform-database-password
# Cube facts 只读账号：平台库中由 DBA 预创建的最小权限角色（无 SUPERUSER/CREATEDB/CREATEROLE）。
# 库地址由 scripts/easyv-dev 从 JAVA_DATABASE_URL 派生；一次性建角色的 SQL 见
# `scripts/easyv-dev facts-reader-sql`；facts schema 授权由 migrate 进程幂等执行。
CUBE_DATABASE_USERNAME=ontology_agent_cube_reader
CUBE_DATABASE_PASSWORD=replace-with-cube-reader-password

SESSION_SECRET=replace-with-a-long-random-session-secret
REDIS_KEY_PREFIX=easyv-dev
AUTH_LOCAL_PROVIDER_ENABLED=true
COOKIE_SECURE=false

# Property demo infrastructure. Compose requires these values; no credentials are defaulted.
CUBE_API_SECRET=replace-with-cube-api-secret
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
JAVA_GRAPH_SYNC_ENABLED=true
JAVA_GRAPH_SYNC_POLL_DELAY=5m
GRAPH_SYNC_OPS_SECRET=replace-with-graph-sync-ops-secret

LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=replace-with-provider-key
LLM_PROVIDER_MODEL=replace-with-provider-model
LLM_PROVIDER_MODE=openai-compatible
LLM_PROVIDER_TOOL_CALLING=true
LLM_PROVIDER_STRUCTURED_OUTPUT=native-json-schema

# Bind the demo UI to an explicit intranet address only after confirming host firewall policy.
EASYV_DEMO_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
JAVA_BACKEND_PORT=8080

# Ingestion defaults. EasyV source credentials are deliberately absent from this file; export
# them only in the shell that runs `scripts/easyv-dev ingest` or `scripts/easyv-dev release-worker`. Property ingestion reads the
# controlled staging source through the shared platform PostgreSQL DataSource.
INGEST_MODE=INCREMENTAL
INGEST_TRIGGER=MANUAL
INGEST_REQUESTED_BY=easyv-dev
INGEST_PAGE_SIZE=2000
