# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ide
.idea
.codex-runtime

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example
!.env.easyv-dev.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude

# local analytics runtime data
cube/conf/.cubestore/

# original mysql sql files
docs/original-mysql/*.sql

# scripts/easyv-dev backup 默认输出目录：含业务数据与账号，不得入库
/backups/

# scripts/local-data 导出的真实业务数据快照，不得入库
/snapshots/
