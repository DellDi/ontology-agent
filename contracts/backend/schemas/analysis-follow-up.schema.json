{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-follow-up.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sessionId",
    "ownerUserId",
    "questionText",
    "parentFollowUpId",
    "referencedExecutionId",
    "referencedConclusionTitle",
    "referencedConclusionSummary",
    "resultExecutionId",
    "ontologyVersionId",
    "ontologyVersionBinding",
    "capabilityBinding",
    "inheritedContext",
    "mergedContext",
    "planVersion",
    "currentPlanSnapshot",
    "previousPlanSnapshot",
    "currentPlanDiff",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "ownerUserId": { "type": "string", "minLength": 1 },
    "questionText": { "type": "string", "minLength": 1, "maxLength": 300 },
    "parentFollowUpId": { "type": ["string", "null"], "minLength": 1 },
    "referencedExecutionId": { "type": "string", "minLength": 1 },
    "referencedConclusionTitle": { "type": ["string", "null"], "minLength": 1 },
    "referencedConclusionSummary": { "type": ["string", "null"], "minLength": 1 },
    "resultExecutionId": { "type": ["string", "null"], "minLength": 1 },
    "ontologyVersionId": { "type": "string", "minLength": 1 },
    "ontologyVersionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontologyVersionId", "source"],
      "properties": {
        "ontologyVersionId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["grounded-context", "inherited", "switched"] }
      }
    },
    "capabilityBinding": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "const": "legacy/unknown" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["domainKey", "capabilityKey", "ontologyVersionId", "resolvedScope"],
          "properties": {
            "domainKey": { "enum": ["property", "easyv"] },
            "capabilityKey": { "enum": ["collection-rate-analysis", "generation-quality-analysis"] },
            "ontologyVersionId": { "type": "string", "minLength": 1 },
            "resolvedScope": {
              "type": "object", "additionalProperties": false,
              "required": ["domainKey", "schemaVersion", "values"],
              "properties": {
                "domainKey": { "enum": ["property", "easyv"] },
                "schemaVersion": { "const": 1 },
                "values": { "type": "object", "minProperties": 1 }
              }
            }
          }
        }
      ]
    },
    "inheritedContext": { "$ref": "#/$defs/context" },
    "mergedContext": { "$ref": "#/$defs/context" },
    "planVersion": { "type": ["integer", "null"], "minimum": 1 },
    "currentPlanSnapshot": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/plan" },
            {
              "type": "object",
              "required": ["_followUpId", "_referencedExecutionId"],
              "properties": {
                "_executionContract": { "const": "java-follow-up-v1" },
                "_followUpId": { "type": "string", "minLength": 1 },
                "_referencedExecutionId": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "previousPlanSnapshot": { "oneOf": [{ "$ref": "#/$defs/plan" }, { "type": "null" }] },
    "currentPlanDiff": { "oneOf": [{ "$ref": "#/$defs/planDiff" }, { "type": "null" }] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "contextField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "state"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "state": { "enum": ["missing", "uncertain", "confirmed"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetMetric", "entity", "timeRange", "comparison", "constraints"],
      "properties": {
        "targetMetric": { "$ref": "#/$defs/contextField" },
        "entity": { "$ref": "#/$defs/contextField" },
        "timeRange": { "$ref": "#/$defs/contextField" },
        "comparison": { "$ref": "#/$defs/contextField" },
        "granularity": { "$ref": "#/$defs/contextField" },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "resolvedContext": {
      "oneOf": [
        { "$ref": "#/$defs/propertyResolvedContext" },
        { "$ref": "#/$defs/easyVResolvedContext" }
      ]
    },
    "propertyResolvedContext": {
      "type": "object", "additionalProperties": false,
      "required": ["entityKey", "metricDefinitionKey", "metricVariantKey", "timeSemanticKey", "projectIds", "from", "to"],
      "properties": {
        "entityKey": { "type": "string", "minLength": 1 },
        "metricDefinitionKey": { "type": "string", "minLength": 1 },
        "metricVariantKey": { "type": "string", "minLength": 1 },
        "timeSemanticKey": { "type": "string", "minLength": 1 },
        "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },
    "easyVResolvedContext": {
      "type": "object", "additionalProperties": false,
      "required": ["entity", "metric", "time", "from", "to", "accessMode", "userId"],
      "properties": {
        "entity": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "accessMode": { "const": "creator-owned" },
        "userId": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "propertyPlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "objective", "dependencyIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "dependencyIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "easyVPlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "planStep": {
      "oneOf": [{ "$ref": "#/$defs/propertyPlanStep" }, { "$ref": "#/$defs/easyVPlanStep" }]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary", "steps", "_executionContract", "_resolvedContext"],
      "properties": {
        "mode": { "enum": ["minimal", "multi-step", "deterministic-read-only"] },
        "summary": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/planStep" } },
        "_executionContract": { "enum": ["java-initial-v1", "java-follow-up-v1"] },
        "_groundedSource": { "type": "string", "minLength": 1 },
        "_groundingStatus": { "enum": ["success", "failed", "ambiguous", "partial", "grounded"] },
        "_toolBindings": { "type": "object" },
        "_executionAssumptions": { "type": "array", "items": { "type": "string" } },
        "_followUpId": { "type": "string", "minLength": 1 },
        "_referencedExecutionId": { "type": "string", "minLength": 1 },
        "_resolvedContext": { "$ref": "#/$defs/resolvedContext" }
      }
    },
    "planDiffStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "title", "reason"],
      "properties": {
        "stepId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "planDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "reusedSteps", "invalidatedSteps", "addedSteps"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "reusedSteps": { "type": "array", "items": { "$ref": "#/$defs/planDiffStep" } },
        "invalidatedSteps": { "type": "array", "items": { "$ref": "#/$defs/planDiffStep" } },
        "addedSteps": { "type": "array", "items": { "$ref": "#/$defs/planDiffStep" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilityBinding": {
            "type": "object",
            "properties": { "source": { "const": "legacy/unknown" } },
            "required": ["source"]
          }
        },
        "required": ["capabilityBinding"]
      },
      "then": {
        "properties": { "resultExecutionId": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "capabilityBinding": { "type": "object", "properties": { "domainKey": { "const": "property" } }, "required": ["domainKey"] } }, "required": ["capabilityBinding"] },
      "then": {
        "properties": {
          "capabilityBinding": {
            "type": "object",
            "required": ["capabilityKey", "resolvedScope"],
            "properties": {
              "capabilityKey": { "const": "collection-rate-analysis" },
              "resolvedScope": {
                "type": "object",
                "required": ["domainKey", "schemaVersion", "values"],
                "properties": {
                  "domainKey": { "const": "property" },
                  "schemaVersion": { "const": 1 },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["organizationId", "projectIds", "areaIds"],
                    "properties": {
                      "organizationId": { "type": "string", "minLength": 1 },
                      "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                      "areaIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                    },
                    "anyOf": [
                      { "required": ["projectIds"], "properties": { "projectIds": { "type": "array", "minItems": 1 } } },
                      { "required": ["areaIds"], "properties": { "areaIds": { "type": "array", "minItems": 1 } } }
                    ]
                  }
                }
              }
            }
          },
          "currentPlanSnapshot": {
            "type": ["object", "null"],
            "properties": {
              "steps": { "type": "array", "items": { "$ref": "#/$defs/propertyPlanStep" } },
              "_resolvedContext": { "$ref": "#/$defs/propertyResolvedContext" }
            }
          },
          "previousPlanSnapshot": {
            "type": ["object", "null"],
            "properties": {
              "steps": { "type": "array", "items": { "$ref": "#/$defs/propertyPlanStep" } },
              "_resolvedContext": { "$ref": "#/$defs/propertyResolvedContext" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "capabilityBinding": { "type": "object", "properties": { "domainKey": { "const": "easyv" } }, "required": ["domainKey"] } }, "required": ["capabilityBinding"] },
      "then": {
        "properties": {
          "capabilityBinding": {
            "type": "object",
            "required": ["capabilityKey", "resolvedScope"],
            "properties": {
              "capabilityKey": { "const": "generation-quality-analysis" },
              "resolvedScope": {
                "type": "object",
                "required": ["domainKey", "schemaVersion", "values"],
                "properties": {
                  "domainKey": { "const": "easyv" },
                  "schemaVersion": { "const": 1 },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["userId", "accessMode"],
                    "properties": {
                      "userId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
                      "accessMode": { "const": "creator-owned" }
                    }
                  }
                }
              }
            }
          },
          "currentPlanSnapshot": {
            "type": ["object", "null"],
            "properties": {
              "steps": { "type": "array", "items": { "$ref": "#/$defs/easyVPlanStep" } },
              "_resolvedContext": { "$ref": "#/$defs/easyVResolvedContext" }
            }
          },
          "previousPlanSnapshot": {
            "type": ["object", "null"],
            "properties": {
              "steps": { "type": "array", "items": { "$ref": "#/$defs/easyVPlanStep" } },
              "_resolvedContext": { "$ref": "#/$defs/easyVResolvedContext" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "planVersion": { "type": "integer" } }, "required": ["planVersion"] },
      "then": {
        "properties": {
          "currentPlanSnapshot": { "type": "object" },
          "previousPlanSnapshot": { "type": "object" },
          "currentPlanDiff": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "currentPlanSnapshot": { "type": "null" },
          "previousPlanSnapshot": { "type": "null" },
          "currentPlanDiff": { "type": "null" }
        }
      }
    }
  ]
}
