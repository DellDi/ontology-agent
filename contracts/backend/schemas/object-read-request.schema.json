{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersionSetId": {
      "type": "string",
      "minLength": 1
    },
    "objectKey": {
      "enum": [
        "easyv-prototype-layout",
        "easyv-prototype-block",
        "easyv-prototype-component"
      ]
    },
    "objectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "relation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "filters": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "EQUALS",
                  "NOT_EQUALS",
                  "CONTAINS",
                  "GT",
                  "GTE",
                  "LT",
                  "LTE",
                  "SET",
                  "NOT_SET"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "maxItems": 100
              }
            },
            "required": [
              "member",
              "operator",
              "values"
            ]
          },
          "maxItems": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "ASC",
                  "DESC"
                ]
              }
            },
            "required": [
              "member",
              "direction"
            ]
          },
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "drilldownId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "includeComponentSummary": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "executionId",
    "datasetVersionSetId",
    "objectKey"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object-read-request.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "includeComponentSummary": {
            "const": true
          }
        },
        "required": [
          "includeComponentSummary"
        ]
      },
      "then": {
        "properties": {
          "objectKey": {
            "enum": [
              "easyv-prototype-layout",
              "easyv-prototype-block"
            ]
          },
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "null"
          },
          "drilldownId": {
            "type": "null"
          }
        },
        "required": [
          "objectId"
        ]
      }
    }
  ]
}
