{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "datasetVersionSetId": {
      "type": "string",
      "minLength": 1
    },
    "objectKey": {
      "enum": [
        "easyv-prototype-layout",
        "easyv-prototype-block",
        "easyv-prototype-component"
      ]
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "relation": {
      "enum": [
        "blocks",
        "components"
      ]
    },
    "search": {
      "type": "string",
      "maxLength": 200
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "$id": "workspace-catalog-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
