{
  "$id": "workspace-review-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "selection"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetVersionSetId",
        "references"
      ],
      "properties": {
        "datasetVersionSetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectKey",
              "objectId",
              "productVersionId"
            ],
            "properties": {
              "objectKey": {
                "const": "easyv-prototype-layout"
              },
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "productVersionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
