{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-home.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["viewer", "sessions", "projects"],
  "properties": {
    "viewer": { "$ref": "viewer.schema.json" },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "sessionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "projectIds", "areaIds"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "areaIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "latestExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "status", "jobStatus", "snapshotStatus", "conclusionState", "failurePoint", "errorCode", "jobError", "traceId", "createdAt", "updatedAt"],
      "properties": {
        "executionId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "jobStatus": { "type": ["string", "null"] },
        "snapshotStatus": { "type": ["string", "null"] },
        "conclusionState": {
          "oneOf": [
            { "$ref": "conclusion-state.schema.json" },
            { "type": "null" }
          ]
        },
        "failurePoint": { "type": ["object", "null"] },
        "errorCode": { "type": ["string", "null"] },
        "jobError": { "type": ["string", "null"] },
        "traceId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "type": "object",
            "properties": {
              "conclusionState": {
                "allOf": [
                  { "$ref": "conclusion-state.schema.json" },
                  {
                    "type": "object",
                    "required": ["evidence", "claims"],
                    "properties": {
                      "evidence": { "type": "array", "minItems": 3, "maxItems": 3 },
                      "claims": { "type": "array", "minItems": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "questionText", "status", "scope", "savedContext", "createdAt", "updatedAt", "latestExecution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "questionText": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/sessionScope" },
        "savedContext": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "latestExecution": { "oneOf": [{ "$ref": "#/$defs/latestExecution" }, { "type": "null" }] }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "organizationId", "areaId", "areaName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": ["string", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string", "minLength": 1 },
        "areaId": { "type": ["string", "null"] },
        "areaName": { "type": ["string", "null"] }
      }
    }
  }
}
